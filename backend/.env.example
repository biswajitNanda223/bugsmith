# Model used by every agent. Gemini by default; set GOOGLE_API_KEY (free key: aistudio.google.com).
BUGSMITH_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
# To use Claude instead: pip install "google-adk[extensions]", set BUGSMITH_MODEL=anthropic/claude-sonnet-5-5 and ANTHROPIC_API_KEY.
# Repo the agent may read (local checkout). Defaults to the repo root.
BUGSMITH_REPO_PATH=..
# Optional remote MCP servers (streamable HTTP). When unset, local fixture/code tools are used.
SENTRY_MCP_URL=
GITHUB_MCP_URL=
GITHUB_MCP_TOKEN=
